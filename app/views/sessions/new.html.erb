<div class="w-full max-w-sm">
  <div class="text-center mb-8">
    <h1 class="text-2xl font-bold text-white">WebhookHub</h1>
    <p class="text-gray-500 mt-1 text-sm">Reliable webhook delivery infrastructure</p>
  </div>

  <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
    <h2 class="text-white font-semibold mb-4">Sign in</h2>

    <%= form_with url: login_path, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, "Email", class: "block text-xs text-gray-400 mb-1" %>
        <%= f.email_field :email, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500", placeholder: "you@example.com", autofocus: true %>
      </div>

      <div>
        <%= f.label :password, "Password", class: "block text-xs text-gray-400 mb-1" %>
        <%= f.password_field :password, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500", placeholder: "••••••••" %>
      </div>

      <%= f.submit "Sign in", class: "w-full bg-indigo-600 hover:bg-indigo-500 text-white rounded px-4 py-2 text-sm font-medium cursor-pointer transition-colors" %>
    <% end %>

    <p class="mt-4 text-center text-xs text-gray-500">
      No account? <%= link_to "Sign up", signup_path, class: "text-indigo-400 hover:text-indigo-300" %>
    </p>
  </div>
</div>
