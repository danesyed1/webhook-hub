<div class="max-w-lg mx-auto">
  <h1 class="text-xl font-bold text-white mb-6">Project Settings</h1>

  <%= form_with model: [current_organization, @project], url: organization_project_path(current_organization.slug, @project), method: :patch, class: "bg-gray-900 border border-gray-800 rounded-lg p-6 space-y-4 mb-6" do |f| %>
    <div>
      <%= f.label :name, "Project name", class: "block text-xs text-gray-400 mb-1" %>
      <%= f.text_field :name, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500" %>
    </div>
    <div>
      <%= f.label :description, "Description", class: "block text-xs text-gray-400 mb-1" %>
      <%= f.text_area :description, rows: 2, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500" %>
    </div>
    <div class="flex gap-2">
      <%= f.submit "Save", class: "bg-indigo-600 hover:bg-indigo-500 text-white rounded px-4 py-2 text-sm font-medium cursor-pointer" %>
      <%= link_to "Cancel", organization_project_path(current_organization.slug, @project), class: "text-gray-400 hover:text-white text-sm px-4 py-2" %>
    </div>
  <% end %>

  <div class="bg-gray-900 border border-red-900/40 rounded-lg p-4">
    <h3 class="text-red-400 font-semibold text-sm mb-2">Danger Zone</h3>
    <p class="text-gray-500 text-xs mb-3">Permanently delete this project and all its data.</p>
    <%= button_to "Delete project", organization_project_path(current_organization.slug, @project), method: :delete,
        class: "bg-red-900/50 hover:bg-red-800 text-red-400 border border-red-800 rounded px-3 py-1.5 text-xs",
        data: { turbo_confirm: "Are you sure? This cannot be undone." } %>
  </div>
</div>
