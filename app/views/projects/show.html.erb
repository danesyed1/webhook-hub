<div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <p class="text-gray-500 text-xs"><%= current_organization.name %></p>
      <h1 class="text-xl font-bold text-white"><%= @project.name %></h1>
    </div>
    <div class="flex gap-2">
      <%= link_to "Settings", edit_organization_project_path(current_organization.slug, @project), class: "text-xs text-gray-400 hover:text-white border border-gray-700 rounded px-3 py-1.5" %>
    </div>
  </div>

  <%# Stat cards %>
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold text-white"><%= @stats[:total] %></p>
      <p class="text-xs text-gray-500 mt-0.5">Total deliveries</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold text-green-400"><%= @stats[:successful] %></p>
      <p class="text-xs text-gray-500 mt-0.5">Successful</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold text-red-400"><%= @stats[:failed] %></p>
      <p class="text-xs text-gray-500 mt-0.5">Failed</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold <%= @stats[:success_rate] >= 99 ? 'text-green-400' : 'text-yellow-400' %>"><%= @stats[:success_rate] %>%</p>
      <p class="text-xs text-gray-500 mt-0.5">Success rate</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold text-white"><%= @stats[:avg_latency] %><span class="text-sm text-gray-500">ms</span></p>
      <p class="text-xs text-gray-500 mt-0.5">Avg latency</p>
    </div>
  </div>

  <%# Delivery activity %>
  <div class="bg-gray-900 border border-gray-800 rounded-lg mb-4">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-800">
      <h2 class="text-sm font-semibold text-white">Delivery Activity</h2>
      <%= link_to "View all", organization_project_deliveries_path(current_organization.slug, @project), class: "text-xs text-indigo-400 hover:text-indigo-300" %>
    </div>
    <% if @recent_deliveries.empty? %>
      <div class="px-4 py-8 text-center text-gray-500 text-sm">
        No deliveries yet. <br>
        <span class="text-gray-600">Send an event via the API to get started.</span>
      </div>
    <% else %>
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-gray-800">
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Event</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Endpoint</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Status</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Response</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Duration</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">When</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_deliveries.each do |d| %>
            <tr class="border-b border-gray-800/50 hover:bg-gray-800/30 cursor-pointer" onclick="window.location='<%= organization_project_delivery_path(current_organization.slug, @project, d) %>'">
              <td class="px-4 py-2.5 text-gray-300 font-mono"><%= d.event.event_type %></td>
              <td class="px-4 py-2.5 text-gray-400"><%= d.webhook_endpoint.name %></td>
              <td class="px-4 py-2.5"><%= status_badge(d.status) %></td>
              <td class="px-4 py-2.5"><%= http_status_badge(d.last_attempt&.http_status) %></td>
              <td class="px-4 py-2.5 text-gray-500"><%= d.last_attempt&.duration_ms ? "#{d.last_attempt.duration_ms}ms" : "—" %></td>
              <td class="px-4 py-2.5 text-gray-500"><%= time_ago_in_words(d.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%# Recent failures %>
  <% if @recent_failures.any? %>
    <div class="bg-gray-900 border border-red-900/50 rounded-lg mb-4">
      <div class="px-4 py-3 border-b border-gray-800">
        <h2 class="text-sm font-semibold text-red-400">Recent Failures</h2>
      </div>
      <div class="divide-y divide-gray-800">
        <% @recent_failures.each do |d| %>
          <div class="px-4 py-3 flex items-center justify-between">
            <div>
              <p class="text-gray-300 text-xs font-mono"><%= d.event.event_type %></p>
              <p class="text-gray-500 text-xs"><%= d.webhook_endpoint.name %> · <%= d.attempt_count %> attempts</p>
            </div>
            <%= link_to "Inspect", organization_project_delivery_path(current_organization.slug, @project, d), class: "text-xs text-indigo-400 hover:text-indigo-300" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Endpoints summary %>
  <div class="bg-gray-900 border border-gray-800 rounded-lg">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-800">
      <h2 class="text-sm font-semibold text-white">Endpoints</h2>
      <%= link_to "+ Add endpoint", new_organization_project_endpoint_path(current_organization.slug, @project), class: "text-xs text-indigo-400 hover:text-indigo-300" %>
    </div>
    <% if @endpoints.empty? %>
      <div class="px-4 py-8 text-center text-gray-500 text-sm">
        No endpoints. <%= link_to "Add one", new_organization_project_endpoint_path(current_organization.slug, @project), class: "text-indigo-400 hover:text-indigo-300" %>
      </div>
    <% else %>
      <div class="divide-y divide-gray-800">
        <% @endpoints.each do |ep| %>
          <div class="px-4 py-3 flex items-center justify-between">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="inline-block w-2 h-2 rounded-full <%= ep.enabled? ? 'bg-green-400' : 'bg-gray-600' %>"></span>
                <span class="text-white text-xs font-medium"><%= ep.name %></span>
              </div>
              <p class="text-gray-500 text-xs truncate mt-0.5"><%= ep.url %></p>
            </div>
            <%= link_to "Manage", organization_project_endpoint_path(current_organization.slug, @project, ep), class: "text-xs text-indigo-400 hover:text-indigo-300 shrink-0" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
