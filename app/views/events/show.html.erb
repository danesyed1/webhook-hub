<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Events", organization_project_events_path(current_organization.slug, @project), class: "text-xs text-gray-500 hover:text-gray-300 mb-2 block" %>
    <h1 class="text-xl font-bold text-white font-mono"><%= @event.event_type %></h1>
    <p class="text-gray-500 text-xs mt-1">ID: <span class="font-mono"><%= @event.id %></span> · <%= @event.created_at.strftime("%b %d, %Y at %H:%M:%S UTC") %></p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Payload</h3>
      <pre class="text-xs text-gray-300 font-mono overflow-auto bg-gray-950 rounded p-3 max-h-64"><%= JSON.pretty_generate(@event.payload) %></pre>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Deliveries</h3>
      <% if @deliveries.empty? %>
        <p class="text-xs text-gray-600">No deliveries created for this event.</p>
      <% else %>
        <div class="space-y-2">
          <% @deliveries.each do |d| %>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs text-gray-300"><%= d.webhook_endpoint.name %></p>
                <p class="text-xs text-gray-500"><%= d.attempt_count %> attempts</p>
              </div>
              <div class="flex items-center gap-2">
                <%= status_badge(d.status) %>
                <%= link_to "View", organization_project_delivery_path(current_organization.slug, @project, d), class: "text-xs text-indigo-400 hover:text-indigo-300" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
