<div class="max-w-5xl mx-auto">
  <h1 class="text-xl font-bold text-white mb-6">Events</h1>

  <div class="bg-gray-900 border border-gray-800 rounded-lg">
    <% if @events.empty? %>
      <div class="px-4 py-12 text-center text-gray-500 text-sm">
        No events yet. Send your first event via the API.
      </div>
    <% else %>
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-gray-800">
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Type</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">ID</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Deliveries</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">When</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |e| %>
            <tr class="border-b border-gray-800/50 hover:bg-gray-800/30 cursor-pointer" onclick="window.location='<%= organization_project_event_path(current_organization.slug, @project, e) %>'">
              <td class="px-4 py-2.5 font-mono text-gray-300"><%= e.event_type %></td>
              <td class="px-4 py-2.5 font-mono text-gray-500 text-xs"><%= e.id %></td>
              <td class="px-4 py-2.5">
                <% d = e.deliveries %>
                <span class="text-gray-400"><%= d.count %> total</span>
                <% if d.where(status: "failed").exists? %>
                  <span class="text-red-400 ml-1">(<%= d.where(status: "failed").count %> failed)</span>
                <% end %>
              </td>
              <td class="px-4 py-2.5 text-gray-500"><%= time_ago_in_words(e.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
