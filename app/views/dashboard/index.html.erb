<div class="max-w-5xl mx-auto">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-white">Overview</h1>
    <p class="text-gray-500 text-xs mt-0.5">Welcome back, <%= current_user.name %></p>
  </div>

  <% if @organizations.empty? %>
    <div class="border border-dashed border-gray-700 rounded-lg p-12 text-center">
      <p class="text-gray-500 mb-4">No organizations yet.</p>
      <%= link_to "Create organization", new_organization_path, class: "bg-indigo-600 hover:bg-indigo-500 text-white rounded px-4 py-2 text-sm" %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <% @organizations.each do |org| %>
        <% org.projects.each do |proj| %>
          <% stats = proj.delivery_stats %>
          <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
            <div class="flex items-center justify-between mb-3">
              <div>
                <p class="text-gray-500 text-xs"><%= org.name %></p>
                <h3 class="text-white font-semibold"><%= proj.name %></h3>
              </div>
              <%= link_to "View", organization_project_path(org.slug, proj), class: "text-xs text-indigo-400 hover:text-indigo-300" %>
            </div>
            <div class="grid grid-cols-2 gap-3 text-center">
              <div>
                <p class="text-2xl font-bold text-white"><%= stats[:total] %></p>
                <p class="text-xs text-gray-500">Deliveries</p>
              </div>
              <div>
                <p class="text-2xl font-bold <%= stats[:success_rate] >= 99 ? 'text-green-400' : stats[:success_rate] >= 95 ? 'text-yellow-400' : 'text-red-400' %>"><%= stats[:success_rate] %>%</p>
                <p class="text-xs text-gray-500">Success rate</p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-lg">
      <div class="px-4 py-3 border-b border-gray-800">
        <h2 class="text-sm font-semibold text-white">Recent Deliveries</h2>
      </div>
      <% if @recent_deliveries.empty? %>
        <div class="px-4 py-8 text-center text-gray-500 text-sm">No deliveries yet. Send your first event via the API.</div>
      <% else %>
        <table class="w-full text-xs">
          <thead>
            <tr class="border-b border-gray-800">
              <th class="px-4 py-2 text-left text-gray-500 font-normal">Event</th>
              <th class="px-4 py-2 text-left text-gray-500 font-normal">Endpoint</th>
              <th class="px-4 py-2 text-left text-gray-500 font-normal">Status</th>
              <th class="px-4 py-2 text-left text-gray-500 font-normal">Response</th>
              <th class="px-4 py-2 text-left text-gray-500 font-normal">Time</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_deliveries.each do |d| %>
              <tr class="border-b border-gray-800/50 hover:bg-gray-800/30">
                <td class="px-4 py-2.5 text-gray-300 font-mono"><%= d.event.event_type %></td>
                <td class="px-4 py-2.5 text-gray-400"><%= d.webhook_endpoint.name %></td>
                <td class="px-4 py-2.5"><%= status_badge(d.status) %></td>
                <td class="px-4 py-2.5"><%= http_status_badge(d.last_attempt&.http_status) %></td>
                <td class="px-4 py-2.5 text-gray-500"><%= d.last_attempt&.duration_ms ? "#{d.last_attempt.duration_ms}ms" : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  <% end %>
</div>
