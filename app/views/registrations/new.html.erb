<div class="w-full max-w-sm">
  <div class="text-center mb-8">
    <h1 class="text-2xl font-bold text-white">WebhookHub</h1>
    <p class="text-gray-500 mt-1 text-sm">Reliable webhook delivery without the infrastructure headache</p>
  </div>

  <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
    <h2 class="text-white font-semibold mb-4">Create your account</h2>

    <%= form_with model: @user, url: signup_path, class: "space-y-4" do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-900/30 border border-red-700 rounded px-3 py-2 text-red-400 text-xs">
          <% @user.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Name", class: "block text-xs text-gray-400 mb-1" %>
        <%= f.text_field :name, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500", placeholder: "Jane Smith", autofocus: true %>
      </div>

      <div>
        <%= f.label :email, "Email", class: "block text-xs text-gray-400 mb-1" %>
        <%= f.email_field :email, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500", placeholder: "you@example.com" %>
      </div>

      <div>
        <label class="block text-xs text-gray-400 mb-1">Organization name</label>
        <%= text_field_tag :organization_name, nil, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500", placeholder: "Acme Corp" %>
      </div>

      <div>
        <%= f.label :password, "Password", class: "block text-xs text-gray-400 mb-1" %>
        <%= f.password_field :password, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500", placeholder: "••••••••" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "block text-xs text-gray-400 mb-1" %>
        <%= f.password_field :password_confirmation, class: "w-full bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500", placeholder: "••••••••" %>
      </div>

      <%= f.submit "Create account", class: "w-full bg-indigo-600 hover:bg-indigo-500 text-white rounded px-4 py-2 text-sm font-medium cursor-pointer transition-colors" %>
    <% end %>

    <p class="mt-4 text-center text-xs text-gray-500">
      Already have an account? <%= link_to "Sign in", login_path, class: "text-indigo-400 hover:text-indigo-300" %>
    </p>
  </div>
</div>
