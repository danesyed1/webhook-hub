<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-xl font-bold text-white">API Keys</h1>
  </div>

  <% if flash[:raw_key] %>
    <%# Already rendered in layout flash handling %>
  <% end %>

  <%# Create new key form %>
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-4 mb-4">
    <h3 class="text-sm font-semibold text-white mb-3">Create API Key</h3>
    <%= form_with url: organization_project_api_keys_path(current_organization.slug, @project), method: :post, class: "flex gap-2" do |f| %>
      <%= text_field_tag "api_key[name]", nil, class: "flex-1 bg-gray-950 border border-gray-700 rounded px-3 py-2 text-white text-sm focus:outline-none focus:border-indigo-500", placeholder: "Key name (e.g. Production)" %>
      <%= f.submit "Generate Key", class: "bg-indigo-600 hover:bg-indigo-500 text-white rounded px-4 py-2 text-sm font-medium cursor-pointer" %>
    <% end %>
  </div>

  <%# Keys list %>
  <div class="bg-gray-900 border border-gray-800 rounded-lg">
    <% if @api_keys.empty? %>
      <div class="px-4 py-8 text-center text-gray-500 text-sm">No API keys yet. Create one above.</div>
    <% else %>
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-gray-800">
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Name</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Key</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Status</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Last used</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Created</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @api_keys.each do |key| %>
            <tr class="border-b border-gray-800/50">
              <td class="px-4 py-2.5 text-gray-300"><%= key.name %></td>
              <td class="px-4 py-2.5 font-mono text-gray-400"><%= key.masked_key %></td>
              <td class="px-4 py-2.5">
                <% if key.revoked? %>
                  <span class="text-xs text-red-400 border border-red-800 rounded px-1.5 py-0.5">Revoked</span>
                <% else %>
                  <span class="text-xs text-green-400 border border-green-800 rounded px-1.5 py-0.5">Active</span>
                <% end %>
              </td>
              <td class="px-4 py-2.5 text-gray-500"><%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "Never" %></td>
              <td class="px-4 py-2.5 text-gray-500"><%= key.created_at.strftime("%b %d, %Y") %></td>
              <td class="px-4 py-2.5">
                <% unless key.revoked? %>
                  <%= button_to "Revoke", organization_project_api_key_path(current_organization.slug, @project, key), method: :delete,
                      class: "text-xs text-red-400 hover:text-red-300",
                      data: { turbo_confirm: "Revoke this API key? Applications using it will stop working." } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%# Usage example %>
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-4 mt-4">
    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Usage Example</h3>
    <pre class="text-xs text-gray-300 font-mono overflow-auto bg-gray-950 rounded p-3">curl -X POST https://api.webhookhub.dev/api/v1/projects/<%= @project.id %>/events \
  -H "Authorization: Bearer wh_live_xxxxxxxxxxxx" \
  -H "Content-Type: application/json" \
  -d '{
    "type": "order.created",
    "data": {
      "order_id": "ord_123",
      "amount": 4999
    }
  }'</pre>
  </div>
</div>
