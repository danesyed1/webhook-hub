<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <div>
      <%= link_to "← Endpoints", organization_project_endpoints_path(current_organization.slug, @project), class: "text-xs text-gray-500 hover:text-gray-300 mb-2 block" %>
      <div class="flex items-center gap-3">
        <span class="inline-block w-2.5 h-2.5 rounded-full <%= @endpoint.enabled? ? 'bg-green-400' : 'bg-gray-600' %>"></span>
        <h1 class="text-xl font-bold text-white"><%= @endpoint.name %></h1>
        <span class="text-xs text-gray-500 border border-gray-700 rounded px-2 py-0.5"><%= @endpoint.enabled? ? "Active" : "Disabled" %></span>
      </div>
      <p class="text-gray-500 text-xs mt-1 font-mono"><%= @endpoint.url %></p>
    </div>
    <div class="flex gap-2">
      <%= button_to @endpoint.enabled? ? "Disable" : "Enable", toggle_organization_project_endpoint_path(current_organization.slug, @project, @endpoint), class: "text-xs border border-gray-700 text-gray-400 hover:text-white rounded px-3 py-1.5" %>
      <%= link_to "Edit", edit_organization_project_endpoint_path(current_organization.slug, @project, @endpoint), class: "text-xs border border-gray-700 text-gray-400 hover:text-white rounded px-3 py-1.5" %>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold text-white"><%= @stats[:total] %></p>
      <p class="text-xs text-gray-500">Events</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold text-green-400"><%= @stats[:success_rate] %>%</p>
      <p class="text-xs text-gray-500">Success rate</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold text-white"><%= @stats[:avg_latency] %><span class="text-sm text-gray-500">ms</span></p>
      <p class="text-xs text-gray-500">Avg latency</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-2xl font-bold text-red-400"><%= @stats[:failed] %></p>
      <p class="text-xs text-gray-500">Failed</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <%# Subscribed events %>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Subscribed Events</h3>
      <% if @endpoint.event_types.any? %>
        <ul class="space-y-1">
          <% @endpoint.event_types.each do |et| %>
            <li class="text-xs text-gray-300 font-mono flex items-center gap-1.5">
              <span class="text-green-400">✓</span> <%= et.name %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-xs text-gray-600">No events subscribed</p>
      <% end %>
    </div>

    <%# Signing secret %>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Signing Secret</h3>
      <code class="text-xs text-gray-300 font-mono"><%= @endpoint.masked_secret %></code>
      <div class="mt-3">
        <%= button_to "Rotate Secret", rotate_secret_organization_project_endpoint_path(current_organization.slug, @project, @endpoint),
            class: "text-xs text-yellow-400 border border-yellow-800 rounded px-2 py-1 hover:bg-yellow-900/30",
            data: { turbo_confirm: "Rotating will break any integrations using the current secret. Continue?" } %>
      </div>
    </div>

    <%# Test event %>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Send Test Event</h3>
      <%= form_with url: test_organization_project_endpoint_path(current_organization.slug, @project, @endpoint), method: :post, class: "space-y-2" do |f| %>
        <div>
          <label class="text-xs text-gray-500 block mb-1">Event type</label>
          <%= select_tag :event_type, options_from_collection_for_select(@event_types, :name, :name),
              class: "w-full bg-gray-950 border border-gray-700 rounded px-2 py-1.5 text-white text-xs focus:outline-none focus:border-indigo-500" %>
        </div>
        <div>
          <label class="text-xs text-gray-500 block mb-1">Payload (JSON)</label>
          <%= text_area_tag :payload, '{"test": true}', rows: 3, class: "w-full bg-gray-950 border border-gray-700 rounded px-2 py-1.5 text-white text-xs font-mono focus:outline-none focus:border-indigo-500" %>
        </div>
        <%= f.submit "Send Test", class: "w-full bg-indigo-600 hover:bg-indigo-500 text-white rounded px-3 py-1.5 text-xs cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <%# Recent deliveries %>
  <div class="bg-gray-900 border border-gray-800 rounded-lg">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-800">
      <h2 class="text-sm font-semibold text-white">Recent Deliveries</h2>
    </div>
    <% if @recent_deliveries.empty? %>
      <div class="px-4 py-8 text-center text-gray-500 text-sm">No deliveries yet.</div>
    <% else %>
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-gray-800">
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Event</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Status</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Response</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Duration</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">When</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_deliveries.each do |d| %>
            <tr class="border-b border-gray-800/50 hover:bg-gray-800/30 cursor-pointer" onclick="window.location='<%= organization_project_delivery_path(current_organization.slug, @project, d) %>'">
              <td class="px-4 py-2.5 font-mono text-gray-300"><%= d.event.event_type %></td>
              <td class="px-4 py-2.5"><%= status_badge(d.status) %></td>
              <td class="px-4 py-2.5"><%= http_status_badge(d.last_attempt&.http_status) %></td>
              <td class="px-4 py-2.5 text-gray-500"><%= d.last_attempt&.duration_ms ? "#{d.last_attempt.duration_ms}ms" : "—" %></td>
              <td class="px-4 py-2.5 text-gray-500"><%= time_ago_in_words(d.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
