<div class="max-w-lg mx-auto">
  <h1 class="text-xl font-bold text-white mb-6">Edit Endpoint</h1>
  <%= render "form" %>

  <div class="mt-6 bg-gray-900 border border-red-900/40 rounded-lg p-4">
    <h3 class="text-red-400 font-semibold text-sm mb-2">Danger Zone</h3>
    <p class="text-gray-500 text-xs mb-3">Permanently delete this endpoint and all its delivery history.</p>
    <%= button_to "Delete endpoint", organization_project_endpoint_path(current_organization.slug, @project, @endpoint), method: :delete,
        class: "bg-red-900/50 hover:bg-red-800 text-red-400 border border-red-800 rounded px-3 py-1.5 text-xs",
        data: { turbo_confirm: "Delete this endpoint and all its delivery history? This cannot be undone." } %>
  </div>
</div>
