<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Deliveries", organization_project_deliveries_path(current_organization.slug, @project), class: "text-xs text-gray-500 hover:text-gray-300 mb-2 block" %>
    <div class="flex items-center justify-between">
      <div>
        <div class="flex items-center gap-3">
          <%= status_badge(@delivery.status) %>
          <h1 class="text-xl font-bold text-white font-mono"><%= @event.event_type %></h1>
        </div>
        <p class="text-gray-500 text-xs mt-1">Event ID: <span class="font-mono"><%= @event.id %></span></p>
      </div>
      <% if @delivery.status == "failed" %>
        <%= button_to "Retry Delivery", retry_organization_project_delivery_path(current_organization.slug, @project, @delivery),
            class: "bg-indigo-600 hover:bg-indigo-500 text-white rounded px-3 py-1.5 text-xs" %>
      <% end %>
    </div>
  </div>

  <%# Summary cards %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-xs text-gray-500 mb-1">Endpoint</p>
      <p class="text-white text-sm font-medium"><%= @endpoint.name %></p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-xs text-gray-500 mb-1">Response</p>
      <p class="text-sm"><%= http_status_badge(@delivery.last_attempt&.http_status) %></p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-xs text-gray-500 mb-1">Duration</p>
      <p class="text-white text-sm"><%= @delivery.last_attempt&.duration_ms ? "#{@delivery.last_attempt.duration_ms}ms" : "—" %></p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <p class="text-xs text-gray-500 mb-1">Attempts</p>
      <p class="text-white text-sm"><%= @delivery.attempt_count %></p>
    </div>
  </div>

  <%# Timeline %>
  <div class="bg-gray-900 border border-gray-800 rounded-lg p-4 mb-4">
    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Timeline</h3>
    <div class="space-y-1.5 text-xs font-mono text-gray-400">
      <div class="flex gap-3">
        <span class="text-gray-600"><%= @event.created_at.strftime("%H:%M:%S") %></span>
        <span>Event created</span>
      </div>
      <% @attempts.each do |a| %>
        <div class="flex gap-3">
          <span class="text-gray-600"><%= a.started_at&.strftime("%H:%M:%S") %></span>
          <span>Attempt #<%= a.attempt_number %> — Request sent</span>
        </div>
        <% if a.completed_at %>
          <div class="flex gap-3">
            <span class="text-gray-600"><%= a.completed_at.strftime("%H:%M:%S") %></span>
            <span class="<%= a.success ? 'text-green-400' : 'text-red-400' %>">
              <%= a.success ? "✓ #{a.http_status} response received" : "✗ #{a.error_message || "#{a.http_status} error"}" %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <%# Request payload %>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Request Payload</h3>
      <pre class="text-xs text-gray-300 font-mono overflow-auto bg-gray-950 rounded p-3 max-h-64"><%= JSON.pretty_generate({ id: @event.id, type: @event.event_type, created_at: @event.created_at, data: @event.payload }) %></pre>
    </div>

    <%# Response body %>
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-4">
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Response Body</h3>
      <% last = @delivery.last_attempt %>
      <% if last&.response_body.present? %>
        <pre class="text-xs text-gray-300 font-mono overflow-auto bg-gray-950 rounded p-3 max-h-64"><%= last.response_body %></pre>
      <% elsif last&.error_message.present? %>
        <div class="bg-red-900/20 rounded p-3">
          <p class="text-xs text-red-400 font-mono"><%= last.error_message %></p>
        </div>
      <% else %>
        <p class="text-xs text-gray-600">No response body</p>
      <% end %>
    </div>
  </div>

  <%# Attempt history %>
  <% if @attempts.count > 1 %>
    <div class="bg-gray-900 border border-gray-800 rounded-lg mt-4">
      <div class="px-4 py-3 border-b border-gray-800">
        <h3 class="text-sm font-semibold text-white">Attempt History</h3>
      </div>
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-gray-800">
            <th class="px-4 py-2 text-left text-gray-500 font-normal">#</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">When</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Status</th>
            <th class="px-4 py-2 text-left text-gray-500 font-normal">Duration</th>
          </tr>
        </thead>
        <tbody>
          <% @attempts.each do |a| %>
            <tr class="border-b border-gray-800/50">
              <td class="px-4 py-2.5 text-gray-400">Attempt <%= a.attempt_number %></td>
              <td class="px-4 py-2.5 text-gray-500"><%= a.started_at&.strftime("%H:%M:%S") || "—" %></td>
              <td class="px-4 py-2.5"><%= http_status_badge(a.http_status) %></td>
              <td class="px-4 py-2.5 text-gray-500"><%= a.duration_ms ? "#{a.duration_ms}ms" : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
